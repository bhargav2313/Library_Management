# Copy to .env (tools/db does this for you and fills in a random password).
# Change these to run another project or a second copy side by side.
COMPOSE_PROJECT_NAME=library
DB_CONTAINER=library-postgres
DB_VOLUME=library_postgres_data
DB_IMAGE=public.ecr.aws/supabase/postgres:17.6.1.167
DB_HOST=127.0.0.1
DB_PORT=55433
DB_NAME=library_dev
DB_USER=postgres
DB_PASSWORD=change-me
