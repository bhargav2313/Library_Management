#!/usr/bin/env python3
"""Stop this checkout's Library listeners (UI 8023, API 8024); leave other projects alone."""
import os, re, signal, subprocess, time
from pathlib import Path

root = Path(__file__).resolve().parent.parent
PORTS = (8023, 8024)  # 8023 = Flutter web UI, 8024 = Blueprint API

for port in PORTS:
    result = subprocess.run(['ss', '-lptn', f'sport = :{port}'],
                            capture_output=True, text=True, check=True)
    for pid in set(map(int, re.findall(r'pid=(\d+)', result.stdout))):
        try:
            cwd = Path(os.readlink(f'/proc/{pid}/cwd')).resolve()
            if not cwd.is_relative_to(root):
                print(f'Port {port} belongs to another project; left running.')
                continue
            os.kill(pid, signal.SIGTERM)
            print(f'Stopped Library listener on port {port} (pid {pid}).')
        except ProcessLookupError:
            pass  # process already exited
        except (PermissionError, FileNotFoundError) as error:
            print(f'Could not stop port {port}: {error}')
time.sleep(1)
