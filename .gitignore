# ---- Secrets: never commit ----
# Database settings + password (created by ./tools/db up from .env.example)
.env
.env.*
!.env.example
# Local dev token and uploads (created by the server)
server/.local/

# ---- Flutter SDK (created by `fvm install` / `fvm use`) ----
.fvm/

# ---- Dart / Flutter generated files ----
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
**/build/
coverage/
**/doc/api/
.widget_preview/

# ---- Python (documentation/build_pdf.py) ----
__pycache__/
*.pyc

# ---- Logs, temp and backups ----
*.log
*.tmp
*.bak
*~
*.swp

# ---- Editors and OS ----
.idea/
*.iml
.history/
.DS_Store
Thumbs.db
# Keep the shared VS Code setting that points at the fvm SDK; ignore the rest.
.vscode/*
!.vscode/settings.json

# ---- Private project notes (not shared) ----
documentation/library/
